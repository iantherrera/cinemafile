# Copy this file to `config.env` and fill in real values.
# `config.env` is gitignored — never commit it.

# MongoDB Atlas connection string for the `cinefile` database.
# Atlas > Database > Connect > Drivers. URL-encode special characters in the password.
ATLAS_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# TMDB API key, used to populate movie metadata and poster paths.
# https://www.themoviedb.org/settings/api
REACT_APP_TMDB_KEY=

# Port the Express server listens on.
PORT=5000

# Origin allowed to call this API (CORS). The CRA dev server runs on :3000.
# Set this to the deployed client's origin in production.
CLIENT_ORIGIN=http://localhost:3000
