# Copy this file to `config.env` and fill in real values.
# `config.env` is gitignored — never commit it.

# MongoDB Atlas connection string for the `cinefile` database.
# Atlas > Database > Connect > Drivers. URL-encode special characters in the password.
ATLAS_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# TMDB API key. Used once to generate initData/initMovieData.json; nothing
# reads it at runtime today. The REACT_APP_ prefix is a leftover from Create
# React App and has no meaning now the client is built with Vite.
# https://www.themoviedb.org/settings/api
REACT_APP_TMDB_KEY=

# Port the Express server listens on.
PORT=5000

# Origin allowed to call this API (CORS). The Vite dev server runs on :3000.
# Set this to the deployed client's origin in production.
CLIENT_ORIGIN=http://localhost:3000

# Signing key for session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; a temporary one is generated in development, which
# means sessions do not survive a server restart.
SESSION_SECRET=

# Not set here -- it comes from the environment. Setting NODE_ENV=production
# makes SESSION_SECRET mandatory and marks the session cookie Secure, so it is
# only ever sent over HTTPS.

# Failed sign-in attempts allowed per IP per 15 minutes before further
# attempts are refused with 429. Successful sign-ins are not counted, so
# ordinary use never trips it. Once tripped, the window must pass before that
# address can try again -- including with the correct password.
LOGIN_RATE_LIMIT=10

# Accounts that may be created per IP per hour.
REGISTER_RATE_LIMIT=5

# Only set this when the server sits behind a reverse proxy or load balancer.
# The value is the number of proxy hops to trust (usually 1) or a subnet.
# Without it every forwarded request looks like it came from the proxy, so the
# per-IP limits above behave as a single shared limit. Do not set it to true:
# trusting X-Forwarded-For unconditionally lets a client forge its address and
# walk straight past those limits.
# TRUST_PROXY=1
